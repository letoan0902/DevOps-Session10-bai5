# Tệp mẫu biến môi trường. Sao chép thành .env rồi điền giá trị thật:
#   cp .env.example .env
# Tệp .env KHÔNG được commit (đã chặn trong .gitignore).

# Tên database PostgreSQL sẽ được tạo
DB_NAME=your_db_name
# Tên người dùng PostgreSQL
DB_USER=your_db_user
# Mật khẩu PostgreSQL (đặt mật khẩu mạnh)
DB_PASSWORD=change_me
# Cổng PostgreSQL trong mạng nội bộ compose
DB_PORT=5432
# Cổng host mở cho Backend Web API
PORT=8085
